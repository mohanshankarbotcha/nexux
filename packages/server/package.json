    "start": "node dist/index.js",
    "dev": "node dist/index.js"
  },
  "dependencies": {
    "@nexus/core": "*",
    "express": "^4.21.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3"
  }
}
